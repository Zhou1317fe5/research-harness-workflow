# 复制为 .env 后在本地填写；该文件不进入 Git。
# 空格和特殊字符使用 shell 引号。远程地址在 profiles.json 的 ssh_argv 中配置。
SSH_PASSWORD=''
REMOTE_CONDA_ENV='your_env'
REMOTE_CONDA_SH='/path/to/conda/etc/profile.d/conda.sh'
REMOTE_REPO_ROOT='/path/on/remote/project'

# 可选科研记忆同步；本地模式保持为空。端点填写 MCP_URL 或 API_URL + BANK_ID。
HINDSIGHT_MCP_URL=
HINDSIGHT_API_URL=
HINDSIGHT_BANK_ID=
HINDSIGHT_API_KEY=
